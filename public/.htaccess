<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Si el archivo o directorio existe, servirlo directamente
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Todo lo demas redirigir a index.html (SPA routing)
  RewriteRule . /index.html [L]
</IfModule>

# Cabeceras de seguridad y cache
<IfModule mod_headers.c>
  # Cache para assets estaticos (JS, CSS, imagenes)
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # No cache para index.html (siempre servir la ultima version)
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
